// ZUVRE — Core Data Model
// See docs/12-data-model.md for the full specification and rationale.
//
// Design rules enforced by convention across the app layer (see packages/db/src/scope.ts):
//   1. Every workspace-owned table carries a `workspaceId`.
//   2. All reads/writes to workspace-owned tables MUST go through a scoped client
//      (`scopedDb(workspaceId)`) — never the raw `PrismaClient` — outside of
//      platform-owner administrative paths, which are themselves audited.
//   3. Cross-workspace joins are forbidden at the query layer.

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  emailVerifiedAt   DateTime?
  displayName       String
  handle            String   @unique
  avatarUrl         String?
  passwordHash      String?
  isPlatformOwner   Boolean  @default(false)
  status            UserStatus @default(ACTIVE)
  locale            String   @default("en")
  timeZone          String   @default("UTC")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  sessions          Session[]
  memberships       WorkspaceMember[]
  ownedWorkspaces   Workspace[]        @relation("WorkspaceOwner")
  recoveryFactors   RecoveryFactor[]
  auditActor        AuditLog[]         @relation("AuditActor")
  agentRunsStarted  AgentRun[]         @relation("AgentRunInitiator")
  memoryItems       MemoryItem[]

  @@index([status])
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
  PENDING_VERIFICATION
}

model Session {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceLabel   String?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?

  @@index([userId])
}

model RecoveryFactor {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        RecoveryFactorType
  identifier  String    // hashed/opaque reference (e.g. recovery email hash, phone hash)
  verifiedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
}

enum RecoveryFactorType {
  RECOVERY_EMAIL
  PHONE
  BACKUP_CODES
}

// ---------------------------------------------------------------------------
// Workspaces & Roles
// ---------------------------------------------------------------------------
// A Workspace is the unit of data isolation. A personal account is a
// single-member Workspace created automatically at signup.

model Workspace {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  kind        WorkspaceKind @default(PERSONAL)
  ownerId     String
  owner       User     @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  planId      String
  plan        Plan     @relation(fields: [planId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members         WorkspaceMember[]
  capabilityGrants CapabilityGrant[]
  executions      CapabilityExecution[]
  artifacts       Artifact[]
  agents          Agent[]
  agentRuns       AgentRun[]
  conversations   Conversation[]
  links           ZuvreLink[]
  qrCodes         QrCode[]
  auditLogs       AuditLog[]
  entitlementOverrides EntitlementOverride[]
  subscription    Subscription?

  @@index([ownerId])
}

enum WorkspaceKind {
  PERSONAL
  TEAM
  ORGANIZATION
}

model Role {
  id            String   @id @default(cuid())
  workspaceId   String?  // null => platform-level role (e.g. PLATFORM_OWNER, OPS_ON_CALL)
  workspace     Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  key           String   // e.g. "owner", "editor", "viewer", "ops_on_call"
  label         String
  permissions   Json     // list of permission strings; interpreted by @zuvre/auth
  maxOccupants  Int?     // platform owner can cap seats per role (spec §12)
  createdAt     DateTime @default(now())

  members       WorkspaceMember[]

  @@unique([workspaceId, key])
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId      String
  role        Role     @relation(fields: [roleId], references: [id])
  status      MemberStatus @default(ACTIVE)
  invitedAt   DateTime @default(now())
  joinedAt    DateTime?

  @@unique([workspaceId, userId])
  @@index([workspaceId])
}

enum MemberStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

// ---------------------------------------------------------------------------
// Capability System (see docs/09-capability-system.md)
// ---------------------------------------------------------------------------

model CapabilityDefinition {
  id            String   @id // stable key, e.g. "ai.chat", "image.generate", "site.build"
  version       String   // semver
  displayName   String
  description   String
  category      String
  inputSchema   Json     // JSON Schema for validated input
  outputSchema  Json     // JSON Schema for produced artifacts/results
  requiredPermissions Json // permission strings a grant must satisfy
  isEnabled     Boolean  @default(true)   // platform-wide kill switch (owner-controlled)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  grants        CapabilityGrant[]
  executions    CapabilityExecution[]

  @@unique([id, version])
}

model CapabilityGrant {
  id             String   @id @default(cuid())
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  capabilityId   String
  capability     CapabilityDefinition @relation(fields: [capabilityId], references: [id])
  grantedScopes  Json     // fine-grained scopes, e.g. external network domains allowed
  approvalPolicy ApprovalPolicy @default(AUTO)
  isEnabled      Boolean  @default(true)
  grantedAt      DateTime @default(now())
  grantedByUserId String?

  @@unique([workspaceId, capabilityId])
}

enum ApprovalPolicy {
  AUTO            // capability may run without per-invocation approval
  REQUIRE_APPROVAL // each sensitive invocation needs explicit user/owner approval
  BLOCKED
}

model CapabilityExecution {
  id            String   @id @default(cuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  capabilityId  String
  capability    CapabilityDefinition @relation(fields: [capabilityId], references: [id])
  initiatedByUserId String?
  agentRunId    String?
  agentRun      AgentRun? @relation(fields: [agentRunId], references: [id])
  status        ExecutionStatus @default(QUEUED)
  input         Json
  output        Json?
  error         Json?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime @default(now())

  artifacts     Artifact[]

  @@index([workspaceId, status])
  @@index([capabilityId])
}

enum ExecutionStatus {
  QUEUED
  RUNNING
  AWAITING_APPROVAL
  SUCCEEDED
  FAILED
  CANCELLED
}

model Artifact {
  id            String   @id @default(cuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  executionId   String?
  execution     CapabilityExecution? @relation(fields: [executionId], references: [id])
  kind          String   // "website" | "image" | "document" | "game" | "audio" | ...
  title         String
  storageRef    String   // pointer into blob storage (provider-agnostic)
  metadata      Json
  createdAt     DateTime @default(now())

  link          ZuvreLink?
  qrCodes       QrCode[]

  @@index([workspaceId, kind])
}

// ---------------------------------------------------------------------------
// Agents
// ---------------------------------------------------------------------------

model Agent {
  id            String   @id @default(cuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name          String
  purpose       String
  allowedCapabilityIds Json // subset of capability ids the agent may invoke
  allowExternalWork Boolean @default(false)
  createdAt     DateTime @default(now())

  runs          AgentRun[]

  @@index([workspaceId])
}

model AgentRun {
  id            String   @id @default(cuid())
  agentId       String
  agent         Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  initiatedByUserId String
  initiatedBy   User     @relation("AgentRunInitiator", fields: [initiatedByUserId], references: [id])
  goal          String
  status        ExecutionStatus @default(QUEUED)
  plan          Json?    // step plan the agent produced
  createdAt     DateTime @default(now())
  finishedAt    DateTime?

  executions    CapabilityExecution[]

  @@index([workspaceId, status])
}

// ---------------------------------------------------------------------------
// Conversations & Memory
// ---------------------------------------------------------------------------

model Conversation {
  id          String   @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title       String?
  createdAt   DateTime @default(now())

  messages    Message[]

  @@index([workspaceId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String   // "user" | "assistant" | "system" | "tool"
  content        Json
  createdAt      DateTime @default(now())

  @@index([conversationId])
}

model MemoryItem {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String?  // null => personal memory not tied to one workspace
  scope       String   // "profile" | "preference" | "project" | ...
  content     String
  visibility  MemoryVisibility @default(PRIVATE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, scope])
}

enum MemoryVisibility {
  PRIVATE
  WORKSPACE_SHARED
}

// ---------------------------------------------------------------------------
// Plans, Entitlements, Billing
// ---------------------------------------------------------------------------

model Plan {
  id            String   @id // e.g. "spark", "ember", "atlas", "orbit" — see Brand Book
  name          String
  description   String
  priceMonthlyMinorUnits Int   // 0 for free tiers
  currency      String   @default("USD")
  entitlements  Json     // { capabilityId: { quota, unit, period } }
  isPubliclyVisible Boolean @default(true)
  sortOrder     Int      @default(0)

  workspaces    Workspace[]
  subscriptions Subscription[]
}

model Subscription {
  id            String   @id @default(cuid())
  workspaceId   String   @unique
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  planId        String
  plan          Plan     @relation(fields: [planId], references: [id])
  status        SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime @default(now())
  currentPeriodEnd   DateTime?
  trialEndsAt   DateTime?
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELLED
}

model EntitlementOverride {
  id            String   @id @default(cuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  capabilityId  String
  quota         Int
  unit          String
  period        String
  reason        String?
  createdAt     DateTime @default(now())

  @@index([workspaceId])
}

// ---------------------------------------------------------------------------
// Links & QR (first-class, spec §17–18)
// ---------------------------------------------------------------------------

model ZuvreLink {
  id            String   @id @default(cuid())
  slug          String   @unique
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entityType    String   // "profile" | "artifact" | "agent" | "capability" | ...
  entityId      String
  artifactId    String?  @unique
  artifact      Artifact? @relation(fields: [artifactId], references: [id])
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  qrCodes       QrCode[]

  @@index([workspaceId, entityType])
}

model QrCode {
  id            String   @id @default(cuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  linkId        String?
  link          ZuvreLink? @relation(fields: [linkId], references: [id])
  artifactId    String?
  artifact      Artifact? @relation(fields: [artifactId], references: [id])
  isDynamic     Boolean  @default(true) // dynamic => destination resolved via linkId at scan time
  staticTarget  String?  // used only when isDynamic = false
  styleConfig   Json?
  createdAt     DateTime @default(now())

  @@index([workspaceId])
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

model AuditLog {
  id            String   @id @default(cuid())
  workspaceId   String?
  workspace     Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actorUserId   String?
  actor         User?    @relation("AuditActor", fields: [actorUserId], references: [id])
  actorType     String   // "user" | "agent" | "system" | "owner_ai"
  action        String
  targetType    String?
  targetId      String?
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([actorUserId])
}
