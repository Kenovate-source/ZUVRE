{
  "name": "zuvre",
  "private": true,
  "version": "0.1.0",
  "engines": { "node": ">=20.0.0" },
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @zuvre/db generate",
    "db:migrate": "pnpm --filter @zuvre/db migrate"
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "typescript": "^5.6.0",
    "@types/node": "^22.5.0",
    "prettier": "^3.3.0"
  }
}
